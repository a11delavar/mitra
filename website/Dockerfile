# syntax=docker/dockerfile:1
# Serves the built site. Build it first (`npm run build`); CI does, see .github/workflows/website.yml.
FROM caddy:2-alpine
COPY <<'CADDYFILE' /etc/caddy/Caddyfile
{
	admin off
}

:8080 {
	root * /srv
	encode
	# Moved pages, generated by the build from astro.config.mjs.
	import redirects.caddy
	file_server

	# Astro hashes these, so a changed file always arrives under a new name.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# A release's captures are frozen with it (see releases/), so they never change under their name either.
	@frozen path /releases/*/*.webp /releases/*/*.mp4
	header @frozen Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control no-cache

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
CADDYFILE
COPY redirects.caddy /etc/caddy/redirects.caddy
COPY dist /srv
EXPOSE 8080
