---
import { languageName, localize } from '../i18n'
import Icon from './Icon.astro'

interface Props {
	/** The page's own language. */
	language: string
	/** The page in each language it exists in, its own included. */
	alternates: Array<{ language: string, href: string }>
}

// A choice of where to go, never a stored preference: the address says the language, so a link always opens as sent.
// Plain links, so search engines follow them from one language of a page to the others.
const { language, alternates } = Astro.props
const t = localize(language)
---

{alternates.length > 1 && (
	<div class="language">
		<button type="button" popovertarget="languages" aria-label={t('Language')} title={t('Language')}>
			<Icon name="languages" />
			<span>{language.toUpperCase()}</span>
		</button>
		<nav id="languages" popover aria-label={t('Language')}>
			{alternates.map(alternate => (
				<a href={alternate.href} hreflang={alternate.language} lang={alternate.language} aria-current={alternate.language === language ? 'page' : undefined}>
					{languageName(alternate.language)}
					{alternate.language === language && <Icon name="check" />}
				</a>
			))}
		</nav>
	</div>
)}

<style>
	.language {
		anchor-scope: --languages;
	}

	/* The theme toggle's button, with the language's code beside the glyph. */
	button {
		anchor-name: --languages;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		block-size: 2rem;
		padding-inline: 0.5rem;
		border: 1px solid var(--mitra-hairline);
		border-radius: var(--border-radius);
		background: var(--mitra-wash);
		font: inherit;
		font-size: 1rem;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;

		span {
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.02em;
		}

		&:hover,
		&:focus-visible {
			border-color: var(--mitra-hairline-strong);
			color: var(--color-text);
		}
	}

	/* Below its button, flush with its end; without anchor positioning, under the header's end. */
	[popover] {
		position: fixed;
		inset: auto;
		inset-block-start: 3.5rem;
		inset-inline-end: 1rem;
		margin: 0;
		min-inline-size: 10rem;
		padding: 0.25rem;
		border: 1px solid var(--mitra-hairline);
		border-radius: var(--border-radius);
		background: var(--color-surface);
		box-shadow: 0 8px 24px color-mix(in srgb, black 18%, transparent);
		color: var(--color-text);

		&:popover-open {
			display: grid;
		}
	}

	@supports (anchor-name: --languages) {
		[popover] {
			position-anchor: --languages;
			inset-block-start: calc(anchor(end) + 0.375rem);
			inset-inline-end: anchor(end);
		}
	}

	a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0.625rem;
		border-radius: calc(var(--border-radius) - 2px);
		font-size: 0.875rem;
		color: var(--color-text-muted);
		text-decoration: none;

		&:hover,
		&:focus-visible {
			background: var(--mitra-wash);
			color: var(--color-text);
			outline: none;
		}

		&[aria-current] {
			color: var(--color-text);
			font-weight: 500;
		}
	}
</style>
