---
import { docsBase, localized, withBase } from '../../site.mjs'
import { localize } from '../i18n'

interface Props {
	language: string
}

const { language } = Astro.props
const t = localize(language)

// Inlined, not <img>: most marks are drawn in `currentColor` and must take the page's ink.

const providers = [
	{ id: 'mitra', name: t('Mitra calendars'), doc: 'integrations/mitra', text: t('Built in. Kept on your own server, with no account behind them.') },
	{ id: 'caldav', name: 'CalDAV', doc: 'integrations/caldav' },
	{ id: 'google', name: 'Google Calendar', doc: 'integrations/google' },
	{ id: 'apple', name: 'Apple Calendar', doc: 'integrations/apple' },
	{ id: 'notion', name: 'Notion', doc: 'integrations/notion' },
	{ id: 'tempo', name: 'Tempo', doc: 'integrations/tempo' },
	{ id: 'ics', name: t('Subscriptions'), doc: 'integrations/subscriptions' },
]

const files = import.meta.glob<string>('../logos/*.svg', { eager: true, query: '?raw', import: 'default' })
const marks = providers.map(provider => {
	const svg = files[`../logos/${provider.id}.svg`]
	if (!svg) {
		throw new Error(`Missing provider logo ${provider.id}.svg. Did prepare.mjs run?`)
	}
	return { ...provider, svg }
})
---

<ul class="marks">
	{marks.map(({ id, name, doc, text, svg }) => (
		<li class:list={{ built: !!text }}>
			<a href={withBase(localized(`/${docsBase}/${doc}/`, language))}>
				<span class:list={['mark', id]} set:html={svg} />
				<span class="name">{name}</span>
				{text && <span class="text">{text}</span>}
			</a>
		</li>
	))}
</ul>

<style>
	/* The built-in card stands beside the six providers, which sit three, three or two across so a
	   row is never left with one card on its own. */
	.marks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.built {
		grid-row: span 2;
	}

	@media (width < 64rem) {
		.marks {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.built {
			grid-row: auto;
			grid-column: 1 / -1;
		}
	}

	@media (width < 34rem) {
		.marks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		block-size: 100%;
		padding: 1.25rem 1rem;
		border: 1px solid var(--mitra-hairline);
		border-radius: 12px;
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
		text-decoration: none;
		color: var(--color-text);
		transition: border-color 0.3s var(--mitra-ease), background 0.3s var(--mitra-ease), transform 0.3s var(--mitra-ease);
	}

	a:hover {
		border-color: var(--mitra-hairline-strong);
		background: var(--color-surface);
		transform: translateY(-2px);
	}

	.built a {
		padding: 1.5rem 1.25rem;
		background: var(--color-surface);
	}

	.mark {
		display: inline-flex;
		inline-size: 1.75rem;
		block-size: 1.75rem;
	}

	.mark :global(svg) {
		inline-size: 100%;
		block-size: 100%;
	}

	.name {
		font-size: 0.875rem;
		font-weight: 550;
	}

	.built .name {
		font-size: 1rem;
	}

	.text {
		margin-block-start: auto;
		max-inline-size: 22rem;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}
</style>
