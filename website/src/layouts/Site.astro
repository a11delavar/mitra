---
import { base, languageOf, languages, localized, withBase } from '../../site.mjs'
import Brand from '../components/Brand.astro'
import NavLinks from '../components/NavLinks.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { directionOf, localize } from '../i18n'
import { linkPreview } from '../linkPreview'
import '../styles/base.css'

interface Props {
	title: string
	description: string
	current?: 'home' | 'docs' | 'releases'
	/** The languages the page exists in, English first; a page shown in English for want of a translation counts. */
	languages?: Array<string>
	/** The languages the page is written in, which search engines are told of; the others point at the English page. */
	translated?: Array<string>
}

const { title, description, current = 'home', languages: existing = [languages[0]!], translated = existing } = Astro.props
const { language, path } = languageOf(Astro.url.pathname.slice(base.length))
const t = localize(language)
const url = (to: string) => new URL(withBase(localized(path, to)), Astro.site).href
const canonical = url(translated.includes(language) ? language : languages[0]!)
const alternates = existing.map(to => ({ language: to, href: withBase(localized(path, to)) }))
const preview = await linkPreview(Astro.site)
---

<!doctype html>
<html lang={language} dir={directionOf(language)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* Each language of the page names all of them, itself included, so search engines show the reader's. */}
		{translated.includes(language) && translated.length > 1 && [
			...translated.map(to => <link rel="alternate" hreflang={to} href={url(to)} />),
			<link rel="alternate" hreflang="x-default" href={url(languages[0]!)} />,
		]}
		<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mitra" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={language} />
		<meta property="og:image" content={preview.href} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />

		{/* Starlight's pre-paint theme stamp, for pages Starlight does not render. */}
		<script is:inline>
			;(() => {
				const stored = localStorage.getItem('starlight-theme')
				const choice = stored === 'light' || stored === 'dark' ? stored : 'system'
				const root = document.documentElement
				root.dataset.mitraTheme = choice
				root.dataset.theme = choice === 'system'
					? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
					: choice
			})()
		</script>
	</head>
	<body>
		<a class="skip" href="#main">{t('Skip to content')}</a>
		<header class="header">
			<div class="bar">
				<Brand language={language} />
				<NavLinks current={current} language={language} alternates={alternates} />
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<SiteFooter language={language} />

		<style>
			.skip {
				position: fixed;
				z-index: 10;
				inset-block-start: 0.5rem;
				inset-inline-start: 0.5rem;
				padding: 0.5rem 0.75rem;
				border-radius: var(--border-radius);
				background: var(--color-surface);
				color: var(--color-text);
				text-decoration: none;
				transform: translateY(-200%);
			}

			.skip:focus {
				transform: none;
			}

			.header {
				position: sticky;
				inset-block-start: 0;
				z-index: 5;
				background: var(--mitra-glass);
				backdrop-filter: blur(12px);
				border-block-end: 1px solid var(--mitra-hairline);
			}

			.bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				max-inline-size: var(--mitra-page);
				margin-inline: auto;
				padding: 0.75rem var(--mitra-gutter);
			}
		</style>
	</body>
</html>
