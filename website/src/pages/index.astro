---
import { docsBase, withBase } from '../../site.mjs'
import AppStack from '../components/AppStack.astro'
import Icon from '../components/Icon.astro'
import ProviderMarks from '../components/ProviderMarks.astro'
import Shot from '../components/Shot.astro'
import Site from '../layouts/Site.astro'

const docs = (slug = '') => withBase(`/${docsBase}/${slug}`)

const layers = [
	{
		title: 'The calendar',
		text: 'Week, month, year, timeline and table views of the same entries. Switch between them and you stay where you were.',
	},
	{
		title: 'Your events',
		text: 'Brought in from the calendars you already use and kept in sync. Changes you make in Mitra go back to the original calendar.',
	},
	{
		title: 'Your tasks',
		text: 'Tasks sit on the same days as your events. Drag one onto the calendar to schedule it, or back to the list to unschedule it.',
	},
	{
		title: 'How they connect',
		text: 'Link subtasks and dependencies. When one task moves, you can see what depends on it.',
	},
]

const views = [
	{ name: 'week', title: 'Week', text: 'Hour by hour, with tasks in the same columns as events.' },
	{ name: 'month', title: 'Month', text: 'Recurring things like workouts shrink to small marks, so a busy month stays readable.' },
	{ name: 'year', title: 'Year', text: 'The whole year on one screen. Handy for finding a free week.' },
	{ name: 'timeline', title: 'Timeline', text: 'Your open tasks, one per row, in the order they are due.' },
	{ name: 'table', title: 'Table', text: 'Your entries as rows. Sort and filter them, and change many at once.' },
]

const shownView = `${views.map(({ name }) => `.views:has(#view-${name}:checked) [data-view='${name}']`).join(',\n')} { display: block; }`
---

<Site
	title="Mitra | One calendar to plan your events and tasks"
	description="Mitra is a self-hosted calendar that puts your tasks on the same timeline as your events, and syncs with the calendars you already use."
>
	<div class="progress" aria-hidden="true"></div>

	<section class="hero">
		<div class="intro">
			<h1>One calendar to plan<br />your events and tasks.</h1>
			<p class="lede">
				Mitra is a self-hosted calendar that puts your tasks on the same timeline as your events.
				It connects to the calendars you already use and keeps them in sync.
			</p>
			<div class="actions">
				<a class="cta" href={docs('getting-started/installation/')}>
					Get started
					<Icon name="arrow-right" />
				</a>
				<a class="ghost" href={docs()}>Read the docs</a>
			</div>
			<p class="fineprint">Free and open source. Runs in a single Docker container.</p>
		</div>
		<div class="frame">
			<Shot name="week" alt="Mitra's week view, with events and tasks in the same columns" width={2200} />
		</div>
	</section>

	<section class="layers">
		<header class="lead">
			<h2>Events and tasks on one timeline</h2>
			<p>
				Most tools make you pick between a calendar for your time and a to-do app for your tasks.
				Mitra puts both in one place, so you can see when there is actually room to get things done.
			</p>
		</header>
		<div class="story">
			<div class="stage">
				<AppStack />
				<div class="telling">
					<div class="bars" aria-hidden="true">{layers.map(() => <i></i>)}</div>
					<ol class="captions">
						{layers.map(({ title, text }) => (
							<li>
								<h3>{title}</h3>
								<p>{text}</p>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<section class="views">
		<div class="copy">
			<h2>The same plan in other views</h2>
			<p class="intro-text">
				Every view shows the same entries, and you can switch at any time. Pick the one that suits
				what you are doing.
			</p>
			<div class="tabs" role="radiogroup" aria-label="View">
				{views.map(({ name, title }, index) => (
					<Fragment>
						<input type="radio" name="view" id={`view-${name}`} checked={index === 0} />
						<label for={`view-${name}`}>{title}</label>
					</Fragment>
				))}
			</div>
			{views.map(({ name, text }) => <p class="note" data-view={name}>{text}</p>)}
		</div>
		<div class="screens">
			{views.map(({ name, title }) => (
				<div class="screen" data-view={name}>
					<Shot name={`${name}-detail`} aspect="860 / 900" width={1720} alt={`Mitra's ${title.toLowerCase()} view`} />
				</div>
			))}
		</div>
		<Fragment set:html={`<style>${shownView}</style>`} />
	</section>

	<section class="integrations">
		<header class="lead">
			<h2>Works with the calendars you already use</h2>
			<p>
				Connect an account and Mitra imports its calendars and task lists, then keeps them in sync.
				Your data stays with the provider.
			</p>
		</header>
		<ProviderMarks />
		<p class="aside">
			CalDAV servers can hold both events and tasks. Notion databases work as task lists, and
			published calendar feeds can be added as read-only subscriptions.{' '}
			<a class="link" href={docs('integrations/')}>See what each integration supports.</a>
		</p>
	</section>

	<section class="hosting">
		<div class="lead">
			<h2>Host it yourself</h2>
			<p>
				Mitra runs as one Docker container with a built-in database. Everything it stores is in a
				single folder, so a backup is a copy of that folder.
			</p>
			<div class="actions">
				<a class="cta" href={docs('getting-started/installation/')}>
					Installation guide
					<Icon name="arrow-right" />
				</a>
				<a class="ghost" href={docs('guides/backups/')}>Backups</a>
			</div>
		</div>
		<figure class="terminal">
			<figcaption>compose.yaml</figcaption>
			<pre><code>{`services:
  mitra:
    image: ghcr.io/a11delavar/mitra:latest
    restart: unless-stopped
    ports:
      - '3000:3000'
    volumes:
      - ~/mitra:/app/data
    environment:
      MITRA_URL: 'https://mitra.example.com'`}</code></pre>
			<p class="run"><span class="prompt">$</span> docker compose up -d</p>
		</figure>
	</section>

	<section class="close">
		<h2>Set it up in a few minutes</h2>
		<p>Mitra is open source under the AGPL-3.0. It is still early, so expect some rough edges before 1.0.</p>
		<div class="actions">
			<a class="cta" href={docs('getting-started/installation/')}>
				Get started
				<Icon name="arrow-right" />
			</a>
			<a class="ghost" href="https://github.com/a11delavar/mitra">
				<Icon name="github" />
				View on GitHub
			</a>
		</div>
	</section>
</Site>

<style>
	section {
		max-inline-size: var(--mitra-page);
		margin-inline: auto;
		padding-inline: var(--mitra-gutter);
	}

	section + section {
		padding-block-start: clamp(5rem, 12vh, 9rem);
	}

	.progress {
		position: fixed;
		z-index: 4;
		inset-block-end: 0;
		inset-inline: 0;
		block-size: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		opacity: 0.5;
	}

	/* Scroll-driven rules here use longhands only: a minifier folds `animation-timeline` into the
	   shorthand, which Chrome then rejects whole. */
	@supports (animation-timeline: scroll()) {
		.progress {
			animation-name: fill;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root block);
		}
	}

	@keyframes fill {
		to {
			transform: scaleX(1);
		}
	}

	.lead {
		max-inline-size: 40rem;
		margin-block-end: 3rem;
	}

	h2 {
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
	}

	.lead p,
	.intro-text {
		margin: 1rem 0 0;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
	}

	h3 {
		font-size: 1.0625rem;
	}

	/* ── Actions ──────────────────────────────────────────────────────────────────────────── */

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 2rem;
	}

	.cta,
	.ghost {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		block-size: 2.75rem;
		padding-inline: 1.125rem;
		border-radius: var(--border-radius);
		font-size: 0.9375rem;
		font-weight: 550;
		text-decoration: none;
		transition: all 0.3s var(--mitra-ease);
	}

	.cta {
		background: var(--color-accent);
		color: var(--color-accent-text);
		border: 1px solid transparent;
	}

	.cta:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px color-mix(in srgb, var(--color-accent) 22%, transparent);
	}

	.ghost {
		color: var(--color-text);
		border: 1px solid var(--mitra-hairline-strong);
		background: transparent;
	}

	.ghost:hover {
		background: var(--mitra-wash);
	}

	/* ── Hero ─────────────────────────────────────────────────────────────────────────────── */

	.hero {
		padding-block-start: clamp(3.5rem, 9vh, 7rem);
	}

	.intro {
		max-inline-size: 46rem;
	}

	h1 {
		font-size: clamp(2.25rem, 6vw, 4rem);
		line-height: 1.05;
	}

	.lede {
		margin: 1.5rem 0 0;
		max-inline-size: 34rem;
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.fineprint {
		margin: 1.25rem 0 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.frame {
		margin-block-start: clamp(3rem, 7vw, 5.5rem);
		margin-inline: calc(-1 * clamp(0rem, 4vw, 5rem));
	}

	/* Translate only: rotating or scaling resamples the app's small text into blur. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.frame :global(.shot) {
				animation-name: settle;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root block);
				animation-range: 0 60vh;
			}
		}
	}

	@keyframes settle {
		from {
			transform: translateY(1.5rem);
		}
	}

	/* ── Layers ───────────────────────────────────────────────────────────────────────────── */

	/* Wider than the reading column, never wider than the window (AGENTS.md: a bleed is derived). */
	.stage {
		--wide: min(84rem, 100vw - 2.5rem);
		inline-size: var(--wide);
		margin-inline: calc((100% - var(--wide)) / 2);
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
	}

	.bars {
		display: none;
	}

	.captions {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
	}

	.captions p {
		margin: 0.375rem 0 0;
		color: var(--color-text-muted);
	}

	@media (width < 60rem) {
		.stage {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Pinned while the reader scrolls through it: the layers land one by one and the caption beside
	   them follows. The same at every width; without support the picture simply shows assembled. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.story {
				view-timeline: --story block;
				block-size: calc(100svh + 3 * 70svh);
			}

			.stage {
				position: sticky;
				inset-block-start: 0;
				min-block-size: 100svh;
				padding-block: 4.5rem 2rem;
				align-content: center;
				--scene-room: calc(100svh - 7rem);
			}

			.bars {
				display: flex;
				gap: 0.375rem;
				margin-block-end: 1.5rem;
			}

			.bars i {
				flex: 1;
				block-size: 2px;
				border-radius: 1px;
				background: var(--mitra-hairline-strong) linear-gradient(var(--color-text), var(--color-text)) no-repeat;
				background-size: 0 100%;
				animation-name: bar;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --story;
			}

			.bars i:nth-child(1) { animation-range: contain 0% contain 25%; }
			.bars i:nth-child(2) { animation-range: contain 25% contain 50%; }
			.bars i:nth-child(3) { animation-range: contain 50% contain 75%; }
			.bars i:nth-child(4) { animation-range: contain 75% contain 100%; }

			.captions li {
				grid-area: 1 / 1;
				animation-name: caption;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --story;
			}

			.captions li:nth-child(1) { animation-name: caption-first; animation-range: contain 0% contain 25%; }
			.captions li:nth-child(2) { animation-range: contain 25% contain 50%; }
			.captions li:nth-child(3) { animation-range: contain 50% contain 75%; }
			.captions li:nth-child(4) { animation-name: caption-last; animation-range: contain 75% contain 100%; }

			/* Stacked, the caption needs its room below the scene. */
			@media (width < 60rem) {
				.stage {
					--scene-room: calc(100svh - 17rem);
				}
			}
		}
	}

	@keyframes bar {
		to {
			background-size: 100% 100%;
		}
	}

	@keyframes caption {
		0%, 100% { opacity: 0; }
		15%, 85% { opacity: 1; }
	}

	@keyframes caption-first {
		85% { opacity: 1; }
		100% { opacity: 0; }
	}

	@keyframes caption-last {
		0% { opacity: 0; }
		15% { opacity: 1; }
	}

	/* ── Views ────────────────────────────────────────────────────────────────────────────── */

	/* Stacked until there is room beside the capture for the text and the whole row of view tabs. */
	.views {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
	}

	.copy {
		max-inline-size: 36rem;
	}

	.screens {
		inline-size: 100%;
		max-inline-size: 44rem;
	}

	@media (width >= 72rem) {
		.views {
			grid-template-columns: minmax(min-content, 1fr) minmax(0, 44rem);
			gap: clamp(2.5rem, 5vw, 4rem);
			align-items: center;
		}
	}

	/* The app's own sidebar tabs: a washed track with the chosen one lifted onto the surface. */
	/* Beside the capture it sizes its column; stacked on a phone it scrolls sideways instead. */
	.tabs {
		position: relative;
		display: inline-flex;
		max-inline-size: 100%;
		overflow-x: auto;
		scrollbar-width: none;
		gap: 0.25rem;
		margin-block-start: 2rem;
		padding: 0.25rem;
		border-radius: 0.5rem;
		background: var(--mitra-wash);
	}

	.tabs input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.tabs label {
		padding: 0.4rem 0.875rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color 0.15s ease, background 0.15s ease;
	}

	.tabs label:hover,
	.tabs input:checked + label {
		color: var(--color-text);
	}

	.tabs input:checked + label {
		background: var(--color-surface);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
	}

	.tabs input:focus-visible + label {
		outline: 2px solid var(--focus-ring-color);
		outline-offset: 2px;
	}

	@media (width < 30rem) {
		.tabs label {
			padding-inline: 0.625rem;
			font-size: 0.8125rem;
		}
	}

	[data-view] {
		display: none;
	}

	.note {
		margin: 1rem 0 0;
		min-block-size: 3em;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
	}

	.screen {
		animation: appear 0.35s var(--mitra-ease);
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
	}

	/* ── Integrations ─────────────────────────────────────────────────────────────────────── */

	.aside {
		margin: 1.5rem 0 0;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		max-inline-size: 42rem;
	}

	/* ── Hosting ──────────────────────────────────────────────────────────────────────────── */

	.hosting {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.hosting .lead {
		margin-block-end: 0;
	}

	.terminal {
		margin: 0;
		border: 1px solid var(--mitra-hairline);
		border-radius: 12px;
		background: var(--color-surface);
		overflow: hidden;
	}

	.terminal figcaption {
		padding: 0.625rem 1rem;
		border-block-end: 1px solid var(--mitra-hairline);
		font-family: var(--mitra-font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.terminal pre {
		margin: 0;
		padding: 1rem;
		overflow-x: auto;
	}

	.terminal code {
		font-family: var(--mitra-font-mono);
		font-size: 0.8125rem;
		line-height: 1.7;
		color: color-mix(in srgb, var(--color-text) 88%, var(--color-background));
	}

	.terminal .run {
		display: flex;
		gap: 0.625rem;
		margin: 0;
		padding: 0.875rem 1rem;
		border-block-start: 1px solid var(--mitra-hairline);
		font-family: var(--mitra-font-mono);
		font-size: 0.8125rem;
	}

	.terminal .prompt {
		color: var(--color-text-muted);
	}

	@media (width < 60rem) {
		.hosting {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ── Close ────────────────────────────────────────────────────────────────────────────── */

	.close {
		text-align: center;
	}

	.close p {
		margin: 1rem 0 0;
		color: var(--color-text-muted);
	}

	.close .actions {
		justify-content: center;
	}
</style>
