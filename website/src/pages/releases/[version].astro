---
import { withBase } from '../../../site.mjs'
import Icon from '../../components/Icon.astro'
import Site from '../../layouts/Site.astro'
import { anchorOf, docsUrl, formatDate, labelOf, linesOf, Release, renderMarkdown } from '../../releases'
import '../../styles/releases.css'

export function getStaticPaths() {
	return Release.all().map(release => ({ params: { version: release.version }, props: { release } }))
}

interface Props {
	release: Release
}

const { release } = Astro.props
const intro = release.notes ? await renderMarkdown(release.notes.intro) : ''
const highlights = await Promise.all(release.highlights.map(async highlight => {
	const capture = highlight.capture && release.capture(highlight.capture)
	return { highlight, html: await renderMarkdown(highlight.markdown), capture, size: await capture?.size() }
}))
const rest = await Promise.all((release.notes?.rest ?? []).map(async section => ({ section, html: await renderMarkdown(section.markdown) })))
---

<Site title={`${release.name} | Mitra`} description={release.description} current="releases">
	<link slot="head" rel="alternate" type="application/rss+xml" title="Mitra releases" href={withBase('/releases.xml')} />
	<article class="release" data-state={release.state}>
		<header class="hero">
			<a class="crumb" href={withBase('/releases/')}><Icon name="arrow-left" size="0.9em" />Releases</a>
			{/* The same block as the row on the list, so the navigation moves it rather than reshapes it. */}
			<div class="num">
				<p class="numeral">
					<span class="version" style={release.transition('version')}>{release.version}</span>
					{release.state === 'latest' && <b style={release.transition('mark')}>Latest</b>}
				</p>
				{release.state === 'draft'
					? <small class="dev" style={release.transition('mark')}>
						<svg class="dial" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect class="track" x="3" y="3" width="18" height="18" rx="2" />
							<rect class="stroke" x="3" y="3" width="18" height="18" rx="2" pathLength="100" stroke-dasharray="35 65" transform="rotate(-90 12 12)" />
							<line x1="8" y1="12" x2="16" y2="12" />
						</svg>
						in development
					</small>
					: release.date && <time datetime={release.date} style={release.transition('date')}>{formatDate(release.date)}</time>}
			</div>
			<div class="body">
				<h1 style={release.transition('title', 'text')}>{release.title}</h1>
				{intro && <div class="intro" style={release.transition('intro', 'text')} set:html={intro} />}
				{release.state === 'draft' && <p class="note">In development: these notes describe the next release and change until it ships.</p>}
			</div>
		</header>

		{highlights.map(({ highlight, html, capture, size }, index) => (
			<section class="highlight" id={anchorOf(highlight.heading)} data-side={index % 2 ? 'start' : 'end'}>
				<div class="text">
					<h2>
						{highlight.heading}
						{highlight.docs && <a class="docs" href={docsUrl(highlight.docs.href)} aria-label={`Docs: ${highlight.docs.label}`} title={`Docs: ${highlight.docs.label}`}><Icon name="book-open" /></a>}
					</h2>
					<div class="prose" set:html={html} />
				</div>
				{capture && (
					<figure class="shot" role="img" aria-label={capture.alt}>
						{/* Lazy either way: the browser fetches a lazy image, and plays an autoplaying film, as it comes into view. */}
						{/* Each take links to its own file, so a capture opens at full size in a new tab. */}
						{(['light', 'dark'] as const).map(theme => (
							<a class={`theme-${theme}`} href={capture.url(theme)} target="_blank" rel="noreferrer" title="Open at full size">
								{capture.film
									? <video src={capture.url(theme)} width={size?.width} height={size?.height} autoplay muted loop playsinline preload="none" aria-hidden="true" />
									: <img src={capture.url(theme)} width={size?.width} height={size?.height} alt="" loading="lazy" decoding="async" />}
							</a>
						))}
					</figure>
				)}
			</section>
		))}

		{rest.map(({ section, html }) => (
			<section class="plain" id={anchorOf(section.heading)}>
				<h2>{section.heading}</h2>
				<div class="prose" set:html={html} />
			</section>
		))}

		{release.patches.length > 0 && (
			<section class="emitted" id="patches">
				<h2>Patches</h2>
				{release.patches.map(patch => (
					<div class="patch">
						<b>{patch.version}</b>
						<span class="date">{patch.date && formatDate(patch.date)}</span>
						<ul>
							{patch.categories.flatMap(linesOf).map(line => (
								<li><span>{line.subject}</span>{line.url && <a class="hash" href={line.url} rel="noreferrer">{line.hash}</a>}</li>
							))}
						</ul>
					</div>
				))}
			</section>
		)}

		{release.everything && (
			<section class="emitted" id="everything">
				<h2>Everything in {release.version} <small>{release.counts.map(count => `${count.count} ${count.label.toLowerCase()}`).join(' · ')}</small></h2>
				{release.everything.categories.map(category => (
					<div class="group">
						<h3>{labelOf(category)}</h3>
						<ul>
							{linesOf(category).map(line => (
								<li><span>{line.subject}</span>{line.url && <a class="hash" href={line.url} rel="noreferrer">{line.hash}</a>}</li>
							))}
						</ul>
					</div>
				))}
			</section>
		)}

		{release.notes && release.notes.contributors.length > 0 && (
			<section class="emitted" id="contributors">
				<h2>Contributors</h2>
				<ul class="people">
					{release.notes.contributors.map(person => (
						<li>
							<a href={person.url} rel="noreferrer">
								{person.avatar
									? <img src={person.avatar} alt="" width="40" height="40" loading="lazy" decoding="async" />
									: <span class="initial" aria-hidden="true">{person.name.replace(/^@/, '')[0]}</span>}
								{person.name}
							</a>
							{person.role && <small>{person.role}</small>}
						</li>
					))}
				</ul>
			</section>
		)}
	</article>
</Site>

<script>
	// A film rests on its first frame for a reader who asked for less motion. Everything else about it is the markup's.
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const film of document.querySelectorAll('video')) {
			film.removeAttribute('autoplay')
			film.pause()
		}
	}
</script>

<style>
	.release {
		max-inline-size: var(--mitra-page);
		margin-inline: auto;
		padding: clamp(2rem, 5vh, 3rem) var(--mitra-gutter) 0;
		display: grid;
		gap: clamp(4rem, 10vh, 7rem);

		--release-latest: light-dark(#1f8a5b, #4fc48f);
		--release-dev: light-dark(#2b6cb0, #7fb3f0);
	}

	/* Laid out as the list's row, on the list's column: the numeral's column, then the title's. */
	.hero {
		inline-size: min(100%, var(--release-column));
		margin-inline: auto;
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	/* A squiggle in Mitra's colour closes the hero, where the list draws its hairline. */
	.hero::after {
		content: '';
		grid-column: 1 / -1;
		block-size: 0.5rem;
		margin-block-start: 1.5rem;
		background: var(--color-accent);
		opacity: 0.45;
		mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 8'><path d='M0 4Q5 0 10 4T20 4' fill='none' stroke='black' stroke-width='1.25' stroke-linecap='round'/></svg>") repeat-x left center / 1.25rem 0.5rem;
	}

	.crumb {
		grid-column: 1 / -1;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-block-end: 1rem;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.crumb:hover {
		color: var(--color-text);
	}

	.num {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		/* On the numeral's baseline, which sits a little below the title's cap height. */
		padding-block-start: 0.2rem;
	}

	.numeral {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.version {
		font-size: 2rem;
		font-weight: 650;
		letter-spacing: -0.03em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.numeral b {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--release-latest);
	}

	.num :is(time, small) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	[data-state='latest'] .version {
		color: var(--release-latest);
	}

	[data-state='draft'] .version,
	.dev {
		color: var(--release-dev);
	}

	.body {
		display: grid;
		gap: 1rem;
		max-inline-size: 56rem;
	}

	.note {
		margin: 0;
		font-size: 0.9rem;
		color: var(--release-dev);
	}

	.dial {
		flex: none;
		inline-size: 1em;
		block-size: 1em;
	}

	.dial .track {
		opacity: 0.6;
	}

	.dial .stroke {
		animation: dial-orbit 11s linear infinite;
	}

	@keyframes dial-orbit {
		from {
			stroke-dashoffset: 0;
		}

		to {
			stroke-dashoffset: -100;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dial .stroke {
			animation: none;
		}
	}

	/* As wide as its text: the snapshot a navigation scales is then the text itself, so the title grows from the
	 * list's size to this one instead of jumping, both boxes having the text's own proportions. */
	h1 {
		inline-size: fit-content;
		font-size: clamp(1.625rem, 3vw, 2.25rem);
		text-wrap: pretty;
	}

	.intro {
		max-inline-size: var(--mitra-content);
		font-size: 1.0625rem;
		color: var(--color-text-muted);
	}

	.intro :global(p),
	.prose :global(p) {
		margin: 0;
	}

	.prose :global(p + p) {
		margin-block-start: 0.75rem;
	}

	/* Text beside its capture, the side alternating down the page. */
	.highlight {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
	}

	.highlight[data-side='start'] {
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
	}

	.highlight[data-side='start'] .text {
		order: 2;
	}

	.highlight + .highlight {
		margin-block-start: clamp(1rem, 5vh, 3.5rem);
	}

	.text,
	.plain {
		display: grid;
		gap: 0.75rem;
	}

	.plain > * {
		max-inline-size: var(--mitra-content);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.5rem;
	}

	/* The way to the docs, beside the heading and out of the text. */
	.docs {
		display: inline-flex;
		font-size: 0.8em;
		color: var(--color-text-muted);
		opacity: 0.7;
		transition: opacity 150ms, color 150ms;
	}

	.docs:hover,
	.docs:focus-visible {
		opacity: 1;
		color: var(--color-accent);
	}

	.prose {
		color: var(--color-text-muted);
	}

	.prose :global(a) {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
	}

	/* Never taller than a screen's worth beside its text: a tall capture shrinks to the height and centres in its column. */
	.shot {
		margin: 0;
		inline-size: fit-content;
		max-inline-size: 100%;
		justify-self: center;
		border: 1px solid var(--mitra-hairline-strong);
		border-radius: 10px;
		overflow: hidden;
		background: var(--color-background);
		box-shadow: var(--mitra-shadow-soft);
	}

	.shot a {
		display: block;
	}

	.shot :is(img, video) {
		display: block;
		max-inline-size: 100%;
		max-block-size: min(34rem, 78vh);
		inline-size: auto;
		block-size: auto;
	}

	.shot .theme-dark {
		display: none;
	}

	:global([data-theme='dark']) .shot .theme-light {
		display: none;
	}

	:global([data-theme='dark']) .shot .theme-dark {
		display: block;
	}

	.emitted {
		inline-size: min(100%, var(--release-column));
		margin-inline: auto;
		border-block-start: 1px solid var(--mitra-hairline);
		padding-block-start: 2.5rem;
		display: grid;
		gap: 1.25rem;
	}

	.emitted h2 {
		font-size: 1.25rem;
	}

	.emitted h2 small {
		font-weight: 400;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.patch {
		display: grid;
		grid-template-columns: 4rem 7rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		font-size: 0.9375rem;
	}

	.patch b {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.patch .date {
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.group {
		display: grid;
		gap: 0.4rem;
	}

	h3 {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.emitted ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
	}

	.emitted li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding-block: 0.35rem;
		border-block-end: 1px solid var(--mitra-hairline);
		font-size: 0.9375rem;
	}

	.emitted li:last-child {
		border-block-end: 0;
	}

	.hash {
		flex: none;
		font-family: var(--mitra-font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.hash:hover {
		color: var(--color-text);
	}

	.people {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}

	.people li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.9375rem;
	}

	.people a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.people a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.people :is(img, .initial) {
		inline-size: 2.5rem;
		block-size: 2.5rem;
		border-radius: 50%;
		border: 1px solid var(--mitra-hairline-strong);
	}

	.people .initial {
		display: grid;
		place-items: center;
		font-weight: 600;
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.people small {
		color: var(--color-text-muted);
	}

	@media (width < 48rem) {
		.highlight,
		.highlight[data-side='start'] {
			grid-template-columns: minmax(0, 1fr);
		}

		.highlight[data-side='start'] .text {
			order: 0;
		}

		.patch {
			grid-template-columns: 4rem minmax(0, 1fr);
		}

		.patch .date {
			display: none;
		}
	}

	@media (width < 40rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}

		.num {
			grid-auto-flow: column;
			justify-content: start;
			align-items: baseline;
			gap: 1rem;
		}
	}
</style>
