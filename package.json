	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"start": "node ./scripts/dev.ts",
		"test": "node ./scripts/test.ts && node --test \"out_test/**/*.js\"",
		"lint": "eslint \"**/*.ts\"",
		"build": "node ./scripts/build.ts",
		"db:migration:create": "node ./scripts/db.ts create",
		"db:migration:up": "node ./scripts/db.ts up",
		"db:migration:down": "node ./scripts/db.ts down",
		"i18n:generate": "node ./scripts/i18n.ts",
		"i18n:analyze": "node ./scripts/i18n.ts --analyze",
		"changelog": "git-cliff -o CHANGELOG.md",
		"release": "node ./scripts/release.ts"
	},
	"devDependencies": {
		"@a11d/eslint-config": "1.x",
		"@eslint/eslintrc": "3.x",
		"@eslint/js": "9.x",
		"@types/compression": "1.8.x",
		"@types/cors": "2.8.x",
		"@types/express": "5.0.x",
		"@types/node": "25.9.x",
		"@types/web-push": "3.x",
		"@typescript/native-preview": "latest",
		"esbuild": "x",
		"eslint": "9.x",
		"favicons": "7.x",
		"git-cliff": "2.x",
		"tsx": "4.x"
	},
	"dependencies": {
		"@3mo/date-time": "0.10.x",
		"@3mo/date-time-value-constructor": "x",
		"@3mo/intersection-observer": "x",
		"@3mo/localization": "x",
		"@3mo/media-query-observer": "x",
		"@3mo/reorderability": "^0.1.0",
		"@3mo/resize-observer": "x",
		"@3mo/swipeability": "x",
		"@a11d/api": "0.5.x",
		"@a11d/api-model-value-constructor": "1.3.x",
		"@a11d/bidirectional-map": "0.1.x",
		"@a11d/equals": "x",
		"@a11d/lit": "x",
		"@a11d/lit-application": "x",
		"@a11d/lit-application-native": "x",
		"@lit/task": "x",
		"@mikro-orm/core": "7.1.5",
		"@mikro-orm/decorators": "7.1.5",
		"@mikro-orm/migrations": "7.1.5",
		"@mikro-orm/reflection": "7.1.5",
		"@mikro-orm/sqlite": "7.1.5",
		"compression": "1.8.x",
		"consola": "^3.x",
		"cors": "x",
		"dotenv": "x",
		"express": "x",
		"ical.js": "x",
		"lucide": "x",
		"marked": "18.x",
		"openid-client": "6.x",
		"temporal-polyfill": "0.2.x",
		"tsdav": "2.x",
		"web-push": "3.x"
	},
	"engines": {
		"node": ">=26"
	}
}
