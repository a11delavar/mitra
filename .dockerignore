# Rebuilt inside the image, so never copy host artifacts/deps in.
node_modules
**/node_modules
out
out_test
dist

# Local data / secrets must not leak into the image.
data
**/.env
*.sqlite

# VCS, CI, editor, docs.
.git
.github
.vscode
.idea
website
*.md
# …except the changelog, which is a runtime asset now (the What's-New dialog serves it; see
# src/backend/changelog.ts), copied into the image by the Dockerfile.
!CHANGELOG.md
# …and the release notes and their translations, which the build bundles into dist/ (see scripts/releaseAssets.ts).
!releases/*/README.md
!releases/*/README.*.md
# …and the site's address, which the app's release notes link to (website/site.mjs states it once).
!website/site.mjs

# Misc
.DS_Store
npm-debug.log*
